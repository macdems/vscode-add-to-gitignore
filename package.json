{
	"name": "add-to-gitignore",
	"displayName": "Add to GIT Ignore",
	"description": "Add file to .gitignore",
	"publisher": "maciejdems",
	"license": "MIT",
	"icon": "images/icon.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/macdems/vscode-add-to-gitignore.git"
	},
	"version": "1.1.0",
	"engines": {
		"vscode": "^1.74.0"
	},
	"categories": [
		"Other"
	],
	"keywords": [
		"git",
		"gitignore"
	],
	"activationEvents": [],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "addToGitignore.addFolderToGitIgnore",
				"title": "Add to GIT Ignore List..."
			},
			{
				"command": "addToGitignore.addFileToGitIgnore",
				"title": "Add to GIT Ignore List..."
			},
			{
				"command": "addToGitignore.addFolderToGitIgnoreFromSCM",
				"title": "Add to GIT Ignore List..."
			},
			{
				"command": "addToGitignore.addFileToGitIgnoreFromSCM",
				"title": "Add to GIT Ignore List..."
			}
		],
		"menus": {
			"explorer/context": [
				{
					"command": "addToGitignore.addFolderToGitIgnore",
					"when": "explorerResourceIsFolder",
					"group": "git"
				},
				{
					"command": "addToGitignore.addFileToGitIgnore",
					"when": "!explorerResourceIsFolder",
					"group": "git"
				}
			],
			"scm/resourceFolder/context": [
				{
					"command": "addToGitignore.addFolderToGitIgnoreFromSCM",
					"when": "scmProvider == git && (scmResourceGroup == workingTree || scmResourceGroup == untracked)",
					"group": "1_modification"
				}
			],
			"scm/resourceState/context": [
				{
					"command": "addToGitignore.addFileToGitIgnoreFromSCM",
					"when": "scmProvider == git && (scmResourceGroup == workingTree || scmResourceGroup == untracked)",
					"group": "1_modification"
				}
			],
			"commandPalette": []
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"lint": "eslint src --ext ts",
		"watch": "tsc -watch -p ./",
		"pretest": "npm run compile && npm run lint",
		"package": "vsce package",
		"publish": "vsce publish"
	},
	"devDependencies": {
		"@types/glob": "^7.1.1",
		"@types/mocha": "^7.0.2",
		"@types/node": "^13.11.0",
		"@types/vscode": "^1.51.0",
		"@typescript-eslint/eslint-plugin": "^2.30.0",
		"@typescript-eslint/parser": "^2.30.0",
		"eslint": "^6.8.0",
		"glob": "^7.1.6",
		"mocha": "^7.1.2",
		"typescript": "^3.8.3",
		"vscode-test": "^1.3.0"
	},
	"dependencies": {
		"vsce": "^1.96.3"
	}
}
